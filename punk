<!DOCTYPE html>
<html lang="it">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>ALICEPUNK - Scheda Personaggio</title>

    <style>
        * { margin: 0; padding: 0; box-sizing: border-box; }

        body {
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
            background: linear-gradient(135deg, #1a1a2e 0%, #16213e 100%);
            color: #e0e0e0;
            padding: 20px;
        }

        .container {
            max-width: 1400px;
            margin: auto;
            background: white;
            color: #333;
            padding: 30px;
            border-radius: 10px;
        }

        .header {
            text-align: center;
            border-bottom: 4px solid #ff006e;
            margin-bottom: 25px;
            padding-bottom: 15px;
        }

        .title {
            font-size: 3em;
            font-weight: 900;
            background: linear-gradient(45deg, #ff006e, #00d9ff);
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
            letter-spacing: 6px;
        }

        .two-column-grid {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 25px;
        }

        .section { margin-bottom: 20px; }

        .section-header {
            background: linear-gradient(135deg, #ff006e, #8b00ff);
            color: white;
            padding: 8px 12px;
            border-radius: 5px;
            font-weight: bold;
            margin-bottom: 10px;
        }

        .instruction {
            background: #f5f5f5;
            padding: 8px;
            border-left: 3px solid #ff006e;
            font-size: 0.85em;
            margin-bottom: 10px;
        }

        label {
            font-weight: bold;
            color: #ff006e;
            margin-bottom: 4px;
            display: block;
        }

        input, textarea {
            width: 100%;
            padding: 8px;
            border: 2px solid #ddd;
            border-radius: 5px;
            margin-bottom: 8px;
        }

        textarea { resize: vertical; }

        .class-grid, .pool-options {
            display: grid;
            grid-template-columns: repeat(4, 1fr);
            gap: 8px;
        }

        .class-option, .pool-option {
            border: 2px solid #ddd;
            padding: 8px;
            text-align: center;
            cursor: pointer;
            border-radius: 5px;
            font-weight: bold;
        }

        .class-option.selected, .pool-option.selected {
            background: #ff006e;
            color: white;
            border-color: #ff006e;
        }

        .skills-selector { display: none; }
        .skills-selector.active { display: block; }

        .skill-checkbox {
            border-left: 3px solid #00d9ff;
            padding: 8px;
            background: #f9f9f9;
            margin-bottom: 6px;
        }

        .pool-values { font-size: 1.2em; }

        .cyber-item {
            border: 2px solid #ddd;
            padding: 6px;
            margin-bottom: 5px;
            display: flex;
            gap: 8px;
        }

        .button-group {
            margin-top: 25px;
            text-align: center;
        }

        button {
            background: linear-gradient(135deg, #ff006e, #8b00ff);
            color: white;
            border: none;
            padding: 12px 20px;
            margin: 5px;
            border-radius: 5px;
            font-weight: bold;
            cursor: pointer;
        }

        @media (max-width: 1100px) {
            .two-column-grid { grid-template-columns: 1fr; }
        }
    </style>
</head>

<body>
<div class="container">

    <div class="header">
        <div class="title">ALICEPUNK</div>
        <p>Scheda Personaggio</p>
    </div>

    <div class="two-column-grid">

        <div>

            <div class="section">
                <div class="section-header">1. IDENTITÀ</div>
                <label>Nome</label>
                <input id="name">

                <div class="instruction">Scegli una classe</div>
                <div class="class-grid">
                    <label class="class-option"><input type="radio" name="class" value="netrunner" onchange="showClassSkills('netrunner')">Netrunner</label>
                    <label class="class-option"><input type="radio" name="class" value="solitario" onchange="showClassSkills('solitario')">Solitario</label>
                    <label class="class-option"><input type="radio" name="class" value="corporativo" onchange="showClassSkills('corporativo')">Corporativo</label>
                    <label class="class-option"><input type="radio" name="class" value="nomade" onchange="showClassSkills('nomade')">Nomade</label>
                </div>
            </div>

            <div class="section">
                <div class="section-header">2. ABILITÀ</div>

                <div id="skills-netrunner" class="skills-selector">
                    <div class="skill-checkbox"><input type="checkbox"> Deep Dive</div>
                    <div class="skill-checkbox"><input type="checkbox"> Firewall Breach</div>
                </div>

                <div id="skills-solitario" class="skills-selector">
                    <div class="skill-checkbox"><input type="checkbox"> Combat Sense</div>
                    <div class="skill-checkbox"><input type="checkbox"> Weapon Master</div>
                </div>

                <div id="skills-corporativo" class="skills-selector">
                    <div class="skill-checkbox"><input type="checkbox"> Negotiation</div>
                    <div class="skill-checkbox"><input type="checkbox"> Authority</div>
                </div>

                <div id="skills-nomade" class="skills-selector">
                    <div class="skill-checkbox"><input type="checkbox"> Vehicle Mastery</div>
                    <div class="skill-checkbox"><input type="checkbox"> Scavenger</div>
                </div>
            </div>

            <div class="section">
                <div class="section-header">3. POOL</div>
                <div class="pool-options">
                    <label class="pool-option"><input type="radio" name="pool" value="balanced">3-3-2-2</label>
                    <label class="pool-option"><input type="radio" name="pool" value="extreme">5-3-2</label>
                </div>
            </div>

        </div>

        <div>

            <div class="section">
                <div class="section-header">4. CYBERWARE</div>
                <div class="cyber-item"><input type="checkbox"> Occhi Cyber</div>
                <div class="cyber-item"><input type="checkbox"> Neural CPU</div>
                <div class="cyber-item"><input type="checkbox"> Sandevistan</div>
            </div>

            <div class="section">
                <div class="section-header">5. NOTE</div>
                <textarea rows="6"></textarea>
            </div>

        </div>

    </div>

    <div class="button-group">
        <button onclick="exportFinalSheet()">🎭 Scarica scheda finale</button>
        <button onclick="location.reload()">🔄 Reset</button>
    </div>

</div>

<script>
function showClassSkills(cls) {
    document.querySelectorAll('.skills-selector').forEach(e => e.classList.remove('active'));
    document.getElementById('skills-' + cls)?.classList.add('active');
    document.querySelectorAll('.class-option').forEach(o => o.classList.remove('selected'));
    event.target.closest('.class-option').classList.add('selected');
}

function exportFinalSheet() {
    const clone = document.documentElement.cloneNode(true);
    const $$ = (s, r = clone) => Array.from(r.querySelectorAll(s));

    $$('.instruction').forEach(e => e.remove());

    const cls = document.querySelector('input[name="class"]:checked')?.value;
    $$('.class-option').forEach(o => {
        if (o.querySelector('input')?.value !== cls) o.remove();
    });

    $$('.skills-selector').forEach(s => {
        if (!s.id.endsWith(cls)) s.remove();
    });

    $$('.skill-checkbox').forEach(s => {
        if (!s.querySelector('input').checked) s.remove();
        else s.querySelector('input').remove();
    });

    const pool = document.querySelector('input[name="pool"]:checked')?.value;
    $$('.pool-option').forEach(p => {
        if (p.querySelector('input')?.value !== pool) p.remove();
        else p.querySelector('input').remove();
    });

    $$('.cyber-item').forEach(c => {
        if (!c.querySelector('input').checked) c.remove();
        else c.querySelector('input').remove();
    });

    $$('.button-group, script').forEach(e => e.remove());

    const html = '<!DOCTYPE html><html lang="it">' + clone.innerHTML + '</html>';
    const blob = new Blob([html], { type: 'text/html' });
    const url = URL.createObjectURL(blob);

    const a = document.createElement('a');
    a.href = url;
    a.download = 'alicepunk_scheda_finale.html';
    a.click();
    URL.revokeObjectURL(url);
}
</script>

</body>
</html>
